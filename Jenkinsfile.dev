// Fallback for a job's first run, before Jenkins has registered the parameters below.
def defaultJarPath = '/home/sounak/Documents/NetBeansProjects/IndianGold/target/indiangold.jar'

pipeline {
    agent none
    options {
        buildDiscarder(logRotator(numToKeepStr: '30'))
        disableConcurrentBuilds()
        quietPeriod(15)
        skipDefaultCheckout()
    }
    parameters {
        string(name: 'JAR_PATH', defaultValue: defaultJarPath, description: 'IDE-built jar on the lin host (dell5558)')
    }
    environment {
        JAR = "${params.JAR_PATH ?: defaultJarPath}"
        GATE_DIR = '/home/sounak/jenkins/release-gate/indiangold'
    }
    stages {
        stage('Collect jar') {
            agent { label 'lin' }
            steps {
                cleanWs()
                sh '''
                    test -s "$JAR" || { echo "Jar not found: $JAR"; exit 1; }
                    unzip -tq "$JAR"
                    cp "$JAR" indiangold_latest.jar
                    sha256sum indiangold_latest.jar
                '''
                script {
                    env.REPO_DIR = sh(returnStdout: true, script: 'dirname "$(dirname "$JAR")"').trim()
                    env.TESTED_COMMIT = sh(returnStdout: true, script: 'git -C "$REPO_DIR" rev-parse HEAD').trim()
                    env.TESTED_TREE = sh(returnStdout: true, script: 'git -C "$REPO_DIR" rev-parse "HEAD^{tree}"').trim()
                    def changes = sh(returnStdout: true, script: 'git -C "$REPO_DIR" status --porcelain').trim()
                    def newerSource = sh(returnStdout: true, script: 'find "$REPO_DIR/src" "$REPO_DIR/pom.xml" -type f -newer "$JAR" | head -1').trim()
                    // A release pass needs the jar and tests to match the commit's exact files.
                    if (changes) {
                        env.GATE_NOTE = 'uncommitted changes'
                    } else if (newerSource) {
                        env.GATE_NOTE = 'jar is older than the sources'
                        echo "Source newer than the jar: ${newerSource}"
                    } else {
                        env.GATE_NOTE = ''
                    }
                    def shortCommit = env.TESTED_COMMIT.substring(0, 7)
                    currentBuild.description = env.GATE_NOTE ? "${shortCommit} (${env.GATE_NOTE}: no release pass)" : shortCommit
                }
                archiveArtifacts artifacts: 'indiangold_latest.jar', fingerprint: true
                stash name: 'jar', includes: 'indiangold_latest.jar'
            }
        }
        stage('Deploy to test machines') {
            parallel {
                stage('lin') {
                    agent { label 'lin' }
                    options { timeout(time: 5, unit: 'MINUTES') }
                    steps {
                        cleanWs()
                        unstash 'jar'
                        sh 'java -version; cp indiangold_latest.jar "$HOME/Desktop/indiangold_latest.jar"; sha256sum "$HOME/Desktop/indiangold_latest.jar"'
                    }
                }
                stage('mac') {
                    agent { label 'mac' }
                    options { timeout(time: 5, unit: 'MINUTES') }
                    steps {
                        cleanWs()
                        unstash 'jar'
                        sh 'java -version; cp indiangold_latest.jar "$HOME/Desktop/indiangold_latest.jar"; shasum -a 256 "$HOME/Desktop/indiangold_latest.jar"'
                    }
                }
                stage('win') {
                    agent { label 'win' }
                    options { timeout(time: 5, unit: 'MINUTES') }
                    steps {
                        cleanWs()
                        unstash 'jar'
                        bat 'java -version && copy /Y indiangold_latest.jar "%USERPROFILE%\\Desktop\\indiangold_latest.jar" && certutil -hashfile "%USERPROFILE%\\Desktop\\indiangold_latest.jar" SHA256'
                    }
                }
            }
        }
        stage('Unit tests') {
            agent { label 'lin' }
            steps {
                sh '''
                    rsync -a --delete --exclude /target --exclude /.git --exclude /bin --exclude '/*.jar' "$REPO_DIR/" src/
                '''
                script {
                    def tree = sh(returnStdout: true, script: 'git -C "$REPO_DIR" rev-parse "HEAD^{tree}"').trim()
                    def changes = sh(returnStdout: true, script: 'git -C "$REPO_DIR" status --porcelain').trim()
                    if (!env.GATE_NOTE && (tree != env.TESTED_TREE || changes)) {
                        env.GATE_NOTE = 'working copy changed during the run'
                        currentBuild.description = "${env.TESTED_COMMIT.substring(0, 7)} (${env.GATE_NOTE}: no release pass)"
                    }
                }
                sh 'cd src && mvn -B -ntp -Dmaven.test.failure.ignore=true test'
                junit allowEmptyResults: true, testResults: 'src/target/surefire-reports/*.xml'
            }
        }
    }
    post {
        success {
            script {
                if (env.GATE_NOTE) {
                    echo "No release pass written: ${env.GATE_NOTE}."
                } else {
                    node('lin') {
                        sh '''
                            mkdir -p "$GATE_DIR"
                            printf 'tree=%s\\ncommit=%s\\ndev_build=%s\\npassed=%s\\n' "$TESTED_TREE" "$TESTED_COMMIT" "$BUILD_NUMBER" "$(date -Iseconds)" > "$GATE_DIR/$TESTED_TREE.tmp"
                            mv "$GATE_DIR/$TESTED_TREE.tmp" "$GATE_DIR/$TESTED_TREE"
                        '''
                        echo "Release pass written for commit ${env.TESTED_COMMIT} (tree ${env.TESTED_TREE})."
                    }
                }
            }
        }
    }
}
